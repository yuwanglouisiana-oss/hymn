#!/usr/bin/env bash
# Git post-receive hook: installed on the SERVER at
#   /var/repo/hymn.git/hooks/post-receive
# Runs automatically after `git push production main`.
# Checks out the pushed code, builds the site, and syncs it into the
# directory your web server serves.
set -euo pipefail

REPO_DIR="$(pwd)"                     # /var/repo/hymn.git (bare repo)
WORKTREE=/var/deploy/hymn-checkout    # scratch checkout used to build
WEBROOT=/var/www/hymn                 # served by nginx/caddy/etc.
BRANCH=main

mkdir -p "$WORKTREE"
git --work-tree="$WORKTREE" --git-dir="$REPO_DIR" checkout -f "$BRANCH"

cd "$WORKTREE"
npm ci
npm run build

mkdir -p "$WEBROOT"
rsync -a --delete dist/ "$WEBROOT/"

echo "Deployed $(date -u +'%Y-%m-%d %H:%M:%S UTC')"
