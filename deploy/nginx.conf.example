# Example server block. Copy into /etc/nginx/sites-available/hymn,
# then: sudo ln -s /etc/nginx/sites-available/hymn /etc/nginx/sites-enabled/
# and adjust server_name + add TLS (e.g. `sudo certbot --nginx`) once DNS points here.

server {
    listen 80;
    listen [::]:80;
    server_name hymn.yourdomain.com;

    root /var/www/hymn;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}
