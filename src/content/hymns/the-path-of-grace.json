  "stanzas": [
    {
      "type": "verse",
      "number": 1,
      "zh": ["祢是我的主，", "引我走正義路，", "高山或低谷，", "都是祢在保護。"],
      "en": [
        "Lord, You are my guide,",
        "the shepherd of my life.",
        "Through the hills and valleys,",
        "You’re always by my side."
      ],
      "startSeconds": 37.9
    },
    {
      "type": "verse",
      "number": 1,
      "zh": ["萬人中唯獨，", "祢愛我認識我，", "永遠不變的應許，", "這一生都是祝福。"],
      "en": [
        "Calling me by name,",
        "You’ve chosen me with love.",
        "Blessing me abundantly,",
        "Your promise will never change."
      ],
      "startSeconds": 51.6
    },
    {
      "type": "chorus",
      "zh": ["一步又一步，", "這是恩典之路，", "祢愛、祢手，", "將我緊緊抓住。"],
      "en": [
        "Every step we take,",
        "You lead us with Your grace.",
        "Your love, Your hand",
        "will hold us close to You."
      ],
      "startSeconds": 69.7
    },
    {
      "type": "chorus",
      "zh": ["一步又一步，", "這是盼望之路，", "祢愛、祢手，", "牽引我走這人生路。"],
      "en": [
        "Every step we take,",
        "You lead us with Your grace.",
        "Your love, Your hand",
        "will guide us through the path of grace."
      ],
      "startSeconds": 85.1
